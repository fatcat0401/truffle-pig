# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single-user lock: comma-separated emails allowed to sign in (empty = nobody)
ALLOWED_EMAILS=

# Supabase (Postgres, Auth with Google OAuth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, bypasses RLS. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Brave Search API
BRAVE_SEARCH_API_KEY=

# Browserbase (cloud browser for the apply robot)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# true = the robot fills the form but never clicks Submit. Keep true unless you review every application.
APPLY_DRY_RUN=true

# Inngest (not needed with the local dev server: npx inngest-cli@latest dev)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
